# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real secrets.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Project Settings → API → service_role (secret).
# Bypasses Row Level Security — used only in app/api/* route handlers.
# NEVER prefix this with NEXT_PUBLIC_ or it will be shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — Settings → API Keys & Webhooks
# Use the pk_test_ / sk_test_ pair while developing, pk_live_ / sk_live_ in production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
